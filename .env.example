# Local dev/test + signing config for the photo-frame app. Copy to `.env` and fill in
# real values:  `cp .env.example .env`  (or run `scripts/init-signing.sh`, which creates
# it for you). `.env` is gitignored — never commit real keys.
#
# On the tablet, the Immich URL + key are entered in the app's Sources UI; the IMMICH_*
# vars here are only for local scripts / verification helpers (see the Makefile).

# ---- Immich (optional, for local scripts) -------------------------------------------

# Immich server base URL (HTTPS; scheme optional — defaults to https).
IMMICH_BASE_URL=https://immich.example.com

# Immich API key. Create in Immich → Account Settings → API Keys with read-only permissions:
#   asset.read, asset.view, album.read, person.read
IMMICH_API_KEY=

# Optional partner API key, made in the partner's own Immich account with asset.delete and
# asset.update. Immich lets only the owner delete or favorite a photo, so the app tries this
# key when the main key cannot change a partner-owned photo. `make immich-config` pushes it with the main key.
IMMICH_PARTNER_API_KEY=

# ---- Release signing ----------------------------------------------------------------
# Used by `scripts/init-signing.sh` (generates the keystore + keystore.properties for a
# fresh clone) and `scripts/set-gh-secrets.sh` (pushes these to GitHub Actions secrets so
# CI can sign release builds). The keystore itself is gitignored and never committed.
#
# This is a SELF-SIGNED key for a personal, sideloaded app — there is no store account to
# protect. Pick any passwords you like; they only gate this local keystore. Keep them (and
# the keystore file) if you want to keep updating an already-installed copy on your tablet:
# Android only accepts an update signed by the same key.

# Path to the keystore file (relative to repo root). init-signing.sh creates it here.
RELEASE_KEYSTORE_FILE=photoframe-release.keystore

# Keystore + key passwords and the key alias.
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_PASSWORD=changeme
RELEASE_KEY_ALIAS=photoframe

# X.500 distinguished name baked into the self-signed cert (only used when init-signing.sh
# generates a NEW keystore; ignored if one already exists).
RELEASE_KEY_DNAME="CN=Photo Frame, OU=Personal, O=Photo Frame, C=US"

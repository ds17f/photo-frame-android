# Local dev/test secrets for the photo-frame app. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit real keys. On the tablet, the Immich URL + key are
# entered in the app's Sources UI; this file is only for local scripts / verification helpers.

# Immich server base URL (HTTPS; scheme optional — defaults to https).
IMMICH_BASE_URL=https://immich.example.com

# Immich API key. Create in Immich → Account Settings → API Keys with read-only permissions:
#   asset.read, asset.view, album.read, person.read
IMMICH_API_KEY=
